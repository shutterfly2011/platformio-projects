// Copy this file to config.h and fill in your own values.
// config.h is gitignored so credentials don't get committed.

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Hostname or IP address of the recording server on your local network.
#define SERVER_HOST "192.168.1.100"
#define SERVER_PORT 5050

// Must match what the server expects (server currently only supports 16-bit PCM).
#define SAMPLE_RATE 16000

// Identifies this device to the server; only used for logging.
#define DEVICE_ID "m5stick-01"
